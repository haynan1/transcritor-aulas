# Gravações e transcrições ficam só nesta máquina: são grandes e o conteúdo
# do curso não é nosso para publicar. A pasta em si vai no repositório.
/Gravações/*
!/Gravações/.gitkeep

# Mídia solta em qualquer lugar do projeto
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.wma
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.aup
*.aup3
*.aup4

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.venv/
venv/

# Gravação atômica interrompida
*.tmp

# Sistema
Thumbs.db
desktop.ini
.DS_Store
